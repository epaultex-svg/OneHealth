      "version": 624,
      "versionNonce": 463122415,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778881184545,
      "link": null,
      "locked": false,
      "text": "Notes/Architecture decisions:\n1. Single agent. Task is sequential, and one context window is enough to complete it\n2. Nexhealth API. Free, functional API for booking healthcare appointments\n3. Fonoster - free, open-source alternative to Twilio\n4. Supabase - free and efficient\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "BPIeXCJcinqanZbM2vrrm",
      "originalText": "Notes/Architecture decisions:\n1. Single agent. Task is sequential, and one context window is enough to complete it\n2. Nexhealth API. Free, functional API for booking healthcare appointments\n3. Fonoster - free, open-source alternative to Twilio\n4. Supabase - free and efficient\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
